{
	"name": "nothingx-x",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"compatibility_date": "2026-08-23",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Create these with:
	//   npx wrangler hyperdrive create nothingx-x-db --connection-string="postgres://..."
	// HYPERDRIVE caches read queries for 60s and does not invalidate on write,
	// which is wrong for auth/admin reads and for the PostView counters.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE_FRESH",
			"id": "8a310d5c325f4af0b32e24ee25609945",
			"localConnectionString": "postgres://postgres:postgres@localhost:5432/nothingx-x"
		}
	],
	"vars": {}
}