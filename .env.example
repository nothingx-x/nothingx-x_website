# Copy to .env for local development. Never commit the real .env.
#
# In production these must be set as host secrets, not files:
#   wrangler secret put DATABASE_URL
#   wrangler secret put SESSION_SECRET
# The build does not read them; they are resolved at request time.

# PostgreSQL connection string.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/nothingx-x"

# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing this invalidates every existing session.
SESSION_SECRET="replace-me-with-32-random-bytes"